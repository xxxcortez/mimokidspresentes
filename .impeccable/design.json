  "narrative": {
    "northStar": "A Arara da Loja Fina",
    "overview": "A vitrine é uma arara de loja delicada: a foto da peça fica pendurada, limpa e grande, e o preço vem numa etiqueta de papel com furo reforçado e barbante rosa, levemente inclinada. A cor entra em blocos de pastel de bebê (abertura rosa-bebê, 'Chegou agora' e rodapé azul-bebê, etiqueta pelo gênero); rosa e turquesa fortes do logo só em detalhes.",
    "keyCharacteristics": [
      "Foto 3:4 limpa como protagonista; o preço mora na etiqueta pendurada.",
      "Pastéis de bebê em áreas grandes, cores fortes do logo só em detalhes.",
      "Títulos estreitos (Encode Sans Condensed) semibold, texto corrido em Ubuntu.",
      "Etiqueta de papel com cantos superiores chanfrados, furo, barbante e inclinação de 3 graus.",
      "Formas de 3 a 4px; círculos apenas para amostras de cor, sacola e fechar."
    ],
    "rules": [
      {
        "name": "The Pastel Block Rule",
        "body": "Pastel de bebê preenche áreas grandes (abertura, faixa, rodapé, etiqueta); o rosa e o turquesa fortes do logo nunca preenchem bloco, só marcam detalhe.",
        "section": "colors"
      },
      {
        "name": "The Tag Color Rule",
        "body": "A cor da etiqueta de preço é função do gênero da peça no catálogo: menina rosa-bebê, menino azul-bebê, unissex amarelo-bebê. Sem gênero, papel branco.",
        "section": "colors"
      },
      {
        "name": "The Turquoise Means Sale Rule",
        "body": "Turquesa em texto ou selo significa promoção; fora disso só o anel de foco.",
        "section": "colors"
      },
      {
        "name": "The Contrast Pink Rule",
        "body": "Texto e estados ativos usam o rosa escurecido (rosa-tinta), nunca o rosa puro do logo.",
        "section": "colors"
      },
      {
        "name": "The Quiet Condensed Rule",
        "body": "Títulos e preços em Encode Condensed minúsculo/misto; tracking positivo só em rótulos de até 19px.",
        "section": "typography"
      },
      {
        "name": "The Paper Shadow Rule",
        "body": "Sombras são difusas, tingidas de ameixa e com desfoque; nunca sólidas, nunca deslocadas sem desfoque.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do manter a foto 3:4 limpa; preço, só na etiqueta pendurada.",
      "Do usar pastel de bebê para blocos grandes e rosa/turquesa fortes só em detalhes.",
      "Do colorir a etiqueta pelo gênero do catálogo e manter ameixa como cor de texto.",
      "Do usar o rosa escurecido (rosa-tinta) para texto e estados ativos.",
      "Do manter sombras difusas e tingidas de ameixa, e respeitar prefers-reduced-motion."
    ],
    "donts": [
      "Don't voltar à direção Armarinho (turquesa em bloco, cartelas, fita métrica), rejeitada pelo usuário.",
      "Don't usar caixa alta gritada nem texto de interface em condensado preto pesado.",
      "Don't pôr o rosa ou o turquesa puros do logo como fundo de bloco.",
      "Don't inventar estoque, prazo ou prova social."
    ]
  }
